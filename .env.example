# ==========================================
# SITRAK BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Port Aplikasi Express (default: 1200)
PORT=1200

# Konfigurasi Koneksi PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=db_sitrak
DB_PASSWORD=postgres
DB_PORT=5432

# Secret Key untuk Verifikasi JWT Token (Gunakan string acak yang kuat)
SECRET=sitrak_jwt_secret_key_production_change_this_secret
